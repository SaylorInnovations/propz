{
  "expo": {
    "name": "Propz Tip Jar",
    "slug": "propz-tip-jar",
    "scheme": "propz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050d18",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saylorinnovations.propz",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.saylorinnovations.propz",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "extra": {
      "supportUrl": "https://saylorinnovations.com/#contact",
      "privacyUrl": "https://propz.saylorinnovations.com/extension-privacy"
    }
  }
}
