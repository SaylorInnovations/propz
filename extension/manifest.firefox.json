{
  "manifest_version": 3,
  "name": "Propz — Tip Jar",
  "version": "1.0.1",
  "description": "Shows a small, non-custodial tip button on pages a creator has registered — sends straight to their wallet, with a disclosed 0.08% fee. Never touches private keys.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tipjar@propz.saylorinnovations.com",
      "strict_min_version": "128.0"
    }
  }
}
