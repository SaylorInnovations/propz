{
  "manifest_version": 3,
  "name": "Propz Tip Button",
  "short_name": "Propz",
  "version": "1.1.0",
  "description": "Build a crypto tip jar for your website or content. Copy a floating button, embedded card, or shareable Solana and Base link.",
  "homepage_url": "https://propz.saylorinnovations.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Propz",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}
