{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propz",
  // Pinned to what the installed wrangler/miniflare's bundled workerd binary
  // actually supports (checked via a local dev-server boot). A newer date
  // here than the binary understands fails startup outright — bump this only
  // together with a `wrangler`/`miniflare` upgrade.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Backs the browser extension's page registrations (URL -> tip jar
  // config), so a creator's own tip button shows for every visitor with
  // the extension installed, not just the person who registered it.
  "kv_namespaces": [
    { "binding": "PROPZ_PAGES", "id": "468faabfb7cd449b8499a7b0e75a8a9a" }
  ],
  // saylorinnovations.com's zone already lives on this Cloudflare account
  // (confirmed via DNS — its nameservers are Cloudflare's), so this just
  // needs `wrangler deploy` to run once authenticated; Cloudflare
  // provisions the DNS record for the custom domain itself.
  "routes": [
    { "pattern": "propz.saylorinnovations.com", "custom_domain": true }
  ]
}
